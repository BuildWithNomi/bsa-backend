# ─────────────────────────────────────────────────────────────────
# BrainSightAI API — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed (see README.md).
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# REQUIRED — Neon connection string.
# Neon console → Dashboard → Connection string → Pooled ("Prisma" / pooler)
# e.g. postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# REQUIRED — JWT signing secrets, 32+ characters each, and they MUST differ.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Optional — defaults shown
PORT=3000
NODE_ENV=development

# Comma-separated allow-list for browser CORS (the Android client is unaffected).
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"

# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_TTL=2592000
# bcrypt cost factor (12 ≈ 250ms/hash)
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────
# First administrator (used by `npm run seed:admin`, never by the API)
# ─────────────────────────────────────────────────────────────────
# No HTTP path can mint an ADMIN, so this is how a fresh database gets its first one:
#   ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='Str0ngPass!' npm run seed:admin
# ADMIN_PASSWORD follows the same policy as registration (8–72 chars, upper + lower + digit).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional — display name for the seeded account (default "Administrator")
ADMIN_FULL_NAME=""
